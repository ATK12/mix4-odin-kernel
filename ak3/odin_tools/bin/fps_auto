#!/system/bin/sh
# Enable daemon fallback mode (delete user flag -> daemon auto maintain 120Hz)
MODDIR=/data/adb/modules/odin_tools
FLAG=$MODDIR/.user_set
rm -f "$FLAG" 2>/dev/null
settings put secure miui_refresh_rate 120 2>/dev/null
settings put system min_refresh_rate 120 2>/dev/null
settings put system user_refresh_rate 120 2>/dev/null
settings put system peak_refresh_rate 120 2>/dev/null
resetprop -n persist.vendor.dfps.level 120 2>/dev/null
echo "OK: auto-daemon mode active (stays 120Hz unless power-saver on)"
